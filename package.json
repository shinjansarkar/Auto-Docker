{
  "name": "auto-docker-extension",
  "displayName": "Auto Docker Extension",
  "description": "AI-powered Docker file generator. Analyzes your project and creates optimized Dockerfile, docker-compose.yml, and nginx.conf files instantly!",
  "publisher": "ShinjanSarkar",
  "icon": "images/docker-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/auto-docker/auto-docker-extension.git"
  },
  "bugs": {
    "url": "https://github.com/auto-docker/auto-docker-extension/issues"
  },
  "homepage": "https://github.com/auto-docker/auto-docker-extension#readme",
  "license": "MIT",
  "version": "2.8.1",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "docker",
    "dockerfile",
    "docker-compose",
    "ai",
    "llm",
    "automation",
    "devops"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "autoDocker.analyzeProject",
        "title": "Analyze Project & Generate Docker Files",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.regenerateDockerFiles",
        "title": "Regenerate Docker Files",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.analyzeProjectDirect",
        "title": "Generate Docker Files (Direct Mode)",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.configureApiKeys",
        "title": "Configure API Keys",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.runTests",
        "title": "Run Comprehensive Tests",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.generateTestProjects",
        "title": "Generate Test Projects",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.showDashboard",
        "title": "Show AI Observability Dashboard",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.exportMetrics",
        "title": "Export AI Metrics",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.showSecurityReport",
        "title": "Show Security Scan Report",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.analyzeDependencies",
        "title": "Analyze Project Dependencies",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.optimizePrompt",
        "title": "Optimize Prompt Engineering",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.showQuickPick",
        "title": "Show Quick Actions Menu",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.showFullDashboard",
        "title": "Open Full Dashboard",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.aiGenerate",
        "title": "AI-Powered Docker Generation",
        "category": "Auto Docker",
        "icon": "$(sparkle)"
      },
      {
        "command": "autoDocker.detectTechStack",
        "title": "Detect Tech Stack with AI",
        "category": "Auto Docker",
        "icon": "$(search)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autoDocker",
          "title": "Auto Docker",
          "icon": "$(docker)"
        }
      ]
    },
    "views": {
      "autoDocker": [
        {
          "id": "autoDocker.projectExplorer",
          "name": "Project Explorer",
          "contextualTitle": "Docker Project"
        },
        {
          "type": "webview",
          "id": "autoDocker.dashboardView",
          "name": "Dashboard",
          "contextualTitle": "Quick Overview"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "autoDocker.analyzeProject",
          "group": "autoDocker",
          "when": "explorerResourceIsRoot"
        }
      ],
      "commandPalette": [
        {
          "command": "autoDocker.analyzeProject"
        },
        {
          "command": "autoDocker.regenerateDockerFiles"
        },
        {
          "command": "autoDocker.analyzeProjectDirect"
        },
        {
          "command": "autoDocker.configureApiKeys"
        },
        {
          "command": "autoDocker.runTests"
        },
        {
          "command": "autoDocker.generateTestProjects"
        },
        {
          "command": "autoDocker.aiGenerate"
        },
        {
          "command": "autoDocker.detectTechStack"
        }
      ]
    },
    "configuration": {
      "title": "Auto Docker Extension",
      "properties": {
        "autoDocker.geminiApiKey": {
          "type": "string",
          "default": "***REMOVED-GEMINI-API-KEY***",
          "description": "Google Gemini API key for Docker file generation"
        },
        "autoDocker.geminiModel": {
          "type": "string",
          "enum": [
            "gemini-2.5-flash",
            "gemini-3.0-flash"
          ],
          "default": "gemini-2.5-flash",
          "description": "Select the Gemini model to use for Docker generation"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "node ./out/test/runTest.js",
    "compile-integration-tests": "tsc -p tsconfig.integration.json",
    "test:integration": "npm run compile-integration-tests && node ./out/test/integration/run-integration-tests.js",
    "test:integration:build": "RUN_DOCKER_BUILD=true npm run test:integration",
    "test:validation": "node test-automation/validateDockerFiles.js",
    "test:build": "node test-automation/testDockerBuild.js",
    "test:all": "npm run test && npm run test:integration",
    "test:vsix": "npm run compile-integration-tests && npm run test:integration",
    "clean": "rimraf dist out .vscode-test",
    "rebuild": "npm run clean && npm install && npm run compile ",
    "package:vsix": "vsce package"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "glob": "^11.1.0",
    "mocha": "^10.8.2",
    "npm-run-all": "^4.1.5",
    "sinon": "^19.0.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.7.8",
    "js-yaml": "^4.1.1",
    "openai": "^4.67.3",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@guardrails-ai/sdk": "^0.4.0"
  }
}
