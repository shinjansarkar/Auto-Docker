{
  "name": "auto-docker-extension",
  "displayName": "Auto Docker Extension",
  "description": "AI-powered Docker file generator. Analyzes your project and creates optimized Dockerfile, docker-compose.yml, and nginx.conf files instantly!",
  "publisher": "ShinjanSarkar",
  "icon": "images/docker-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/auto-docker/auto-docker-extension.git"
  },
  "bugs": {
    "url": "https://github.com/auto-docker/auto-docker-extension/issues"
  },
  "homepage": "https://github.com/auto-docker/auto-docker-extension#readme",
  "license": "MIT",
  "version": "2.6.1",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "docker",
    "dockerfile",
    "docker-compose",
    "ai",
    "llm",
    "automation",
    "devops"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "autoDocker.analyzeProject",
        "title": "Analyze Project & Generate Docker Files",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.regenerateDockerFiles",
        "title": "Regenerate Docker Files",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.analyzeProjectDirect",
        "title": "Generate Docker Files (Direct Mode)",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.configureApiKeys",
        "title": "Configure API Keys",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.runTests",
        "title": "Run Comprehensive Tests",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.generateTestProjects",
        "title": "Generate Test Projects",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.showDashboard",
        "title": "Show AI Observability Dashboard",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.exportMetrics",
        "title": "Export AI Metrics",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.showSecurityReport",
        "title": "Show Security Scan Report",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.analyzeDependencies",
        "title": "Analyze Project Dependencies",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.optimizePrompt",
        "title": "Optimize Prompt Engineering",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.showQuickPick",
        "title": "Show Quick Actions Menu",
        "category": "Auto Docker"
      },
      {
        "command": "autoDocker.showFullDashboard",
        "title": "Open Full Dashboard",
        "category": "Auto Docker"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autoDocker",
          "title": "Auto Docker",
          "icon": "$(docker)"
        }
      ]
    },
    "views": {
      "autoDocker": [
        {
          "id": "autoDocker.projectExplorer",
          "name": "Project Explorer",
          "contextualTitle": "Docker Project"
        },
        {
          "type": "webview",
          "id": "autoDocker.dashboardView",
          "name": "Dashboard",
          "contextualTitle": "Quick Overview"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "autoDocker.analyzeProject",
          "group": "autoDocker",
          "when": "explorerResourceIsRoot"
        }
      ],
      "commandPalette": [
        {
          "command": "autoDocker.analyzeProject"
        },
        {
          "command": "autoDocker.regenerateDockerFiles"
        },
        {
          "command": "autoDocker.analyzeProjectDirect"
        },
        {
          "command": "autoDocker.configureApiKeys"
        },
        {
          "command": "autoDocker.runTests"
        },
        {
          "command": "autoDocker.generateTestProjects"
        }
      ]
    },
    "configuration": {
      "title": "Auto Docker Extension",
      "properties": {
        "autoDocker.apiProvider": {
          "type": "string",
          "enum": [
            "openai",
            "gemini",
            "anthropic"
          ],
          "default": "openai",
          "description": "Select the LLM API provider for Docker file generation"
        },
        "autoDocker.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key for GPT integration"
        },
        "autoDocker.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Google Gemini API key for Gemini integration"
        },
        "autoDocker.anthropicApiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key for Claude integration"
        },
        "autoDocker.model": {
          "type": "string",
          "default": "gpt-4",
          "description": "Model name to use (e.g., gpt-4, gpt-3.5-turbo, gemini-pro)"
        },
        "autoDocker.overwriteFiles": {
          "type": "boolean",
          "default": false,
          "description": "Automatically overwrite existing Docker files without confirmation"
        },
        "autoDocker.includeNginx": {
          "type": "boolean",
          "default": true,
          "description": "Include nginx.conf generation for frontend projects"
        },
        "autoDocker.useReverseProxy": {
          "type": "boolean",
          "default": true,
          "description": "Use nginx as reverse proxy for development mode (separate app and nginx services). When false, uses static file serving."
        },
        "autoDocker.dockerOutputPath": {
          "type": "string",
          "default": "",
          "description": "Custom path for Docker files (relative to workspace root). Leave empty for root."
        },
        "autoDocker.enableGuardrails": {
          "type": "boolean",
          "default": true,
          "description": "Enable Guardrails AI validation for generated Docker files"
        },
        "autoDocker.guardrailsStrictMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable strict validation mode (fails on warnings)"
        },
        "autoDocker.maxReasks": {
          "type": "number",
          "default": 2,
          "description": "Maximum number of re-asks when validation fails (1-5)"
        },
        "autoDocker.useLangChain": {
          "type": "boolean",
          "default": true,
          "description": "Use LangChain for structured output generation (recommended for better reliability)"
        },
        "autoDocker.langChainProvider": {
          "type": "string",
          "enum": [
            "openai",
            "gemini",
            "anthropic"
          ],
          "default": "openai",
          "description": "LangChain provider to use (uses same API key as main provider)"
        },
        "autoDocker.enableStaticAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Enable static analysis and linting for generated Docker files"
        },
        "autoDocker.autoFixIssues": {
          "type": "boolean",
          "default": false,
          "description": "Automatically fix common issues detected by static analysis"
        },
        "autoDocker.staticAnalysisStrictMode": {
          "type": "boolean",
          "default": false,
          "description": "Fail generation if static analysis finds critical issues"
        },
        "autoDocker.enableComposeSpecValidation": {
          "type": "boolean",
          "default": true,
          "description": "Enable Docker Compose Spec validation against official specification"
        },
        "autoDocker.composeSpecStrictMode": {
          "type": "boolean",
          "default": false,
          "description": "Fail generation if Docker Compose has spec violations"
        },
        "autoDocker.enableObservability": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI observability and monitoring for tracking LLM usage, costs, and performance"
        },
        "autoDocker.enableSecurityScanning": {
          "type": "boolean",
          "default": true,
          "description": "Enable comprehensive security scanning for Docker files (secrets, vulnerabilities, compliance)"
        },
        "autoDocker.securityStrictMode": {
          "type": "boolean",
          "default": false,
          "description": "Fail generation if security scan finds critical issues"
        },
        "autoDocker.enableDependencyAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Enable dependency graph analysis for vulnerability detection and optimization"
        },
        "autoDocker.dependencyStrictMode": {
          "type": "boolean",
          "default": false,
          "description": "Fail generation if critical dependency vulnerabilities found"
        },
        "autoDocker.enablePromptEngineering": {
          "type": "boolean",
          "default": true,
          "description": "Enable advanced prompt engineering with optimization and chain-of-thought reasoning"
        },
        "autoDocker.enableRAGEnhancedPrompts": {
          "type": "boolean",
          "default": true,
          "description": "Enhance prompts with RAG (Retrieval Augmented Generation) context"
        },
        "autoDocker.maxPromptTokens": {
          "type": "number",
          "default": 2000,
          "description": "Maximum tokens allowed in prompts (for cost optimization)"
        },
        "autoDocker.enableUIEnhancements": {
          "type": "boolean",
          "default": true,
          "description": "Enable enhanced UI/UX features including dashboards, notifications, and interactive views"
        },
        "autoDocker.showStatusBarUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Show real-time updates in the status bar during generation"
        },
        "autoDocker.enableInteractiveNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Enable interactive notifications with action buttons"
        },
        "autoDocker.autoOpenDashboard": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open dashboard after successful generation"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "node ./out/test/runTest.js",
    "test:integration": "node test-automation/runTests.js",
    "test:validation": "node test-automation/validateDockerFiles.js",
    "test:build": "node test-automation/testDockerBuild.js",
    "test:all": "npm run test && npm run test:integration",
    "clean": "rimraf dist out .vscode-test",
    "rebuild": "npm run clean && npm install && npm run compile",
    "package:vsix": "vsce package"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "glob": "^11.1.0",
    "mocha": "^10.8.2",
    "npm-run-all": "^4.1.5",
    "sinon": "^19.0.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@langchain/anthropic": "^1.3.5",
    "@langchain/core": "^1.1.10",
    "@langchain/google-genai": "^2.1.5",
    "@langchain/openai": "^1.2.1",
    "axios": "^1.7.8",
    "js-yaml": "^4.1.1",
    "langchain": "^1.2.5",
    "openai": "^4.67.3",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@guardrails-ai/sdk": "^0.4.0"
  }
}
